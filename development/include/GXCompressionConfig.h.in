#ifndef GX_COMPRESSION_FIXED_CONFIG_H
#define GX_COMPRESSION_FIXED_CONFIG_H
/** @file @brief Installed configuration matching the compiled library ABI. */
#cmakedefine GX_COMPRESSION_WITH_TRACE
#ifdef GX_COMPRESSION_WITH_TRACE
#ifndef COMPRESSION_TRACE
#define COMPRESSION_TRACE
#endif
#elif defined(COMPRESSION_TRACE)
#error "The installed Gurux compression library was built without COMPRESSION_TRACE."
#endif
#endif
